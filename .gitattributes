# Keep line endings stable across platforms.
#
# The injected UI scripts are JavaScript source inside template literals, and a
# test asserts that no stray carriage return reaches the generated page. A CRLF
# checkout on a Windows runner would make that assertion fail for reasons that
# have nothing to do with the code, so everything is checked out as LF.
* text=auto eol=lf

# Windows-only helpers keep their CRLF endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never touched.
*.png binary
*.ico binary
*.exe binary
*.zip binary
*.7z binary
