{
  "name": "pi-heao-gui",
  "version": "1.1.3",
  "description": "Windows desktop client for the pi coding agent, extracted from the pi-agent-studio VS Code extension",
  "main": "dist/main/main.js",
  "author": "HEAOZIE",
  "license": "MIT",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "watch": "tsc -w",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "npm run build && node --test \"test/**/*.test.cjs\"",
    "smoke": "electron scripts/smoke.cjs",
    "icon": "electron scripts/make-icon.cjs",
    "build:renderer": "cd studio/pi-chat && npm install && npm run build",
    "build:mcp": "cd studio/pi-mcp && npm install && npm run build",
    "dist": "npm run build && electron-builder --win portable nsis --publish never",
    "shot": "electron scripts/screenshot.cjs",
    "shots": "electron scripts/readme-shots.cjs",
    "verify": "electron scripts/verify-features.cjs",
    "e2e": "electron scripts/e2e.cjs",
    "e2e:isolated": "electron scripts/e2e.cjs --isolated",
    "measure-load": "electron scripts/measure-load.cjs",
    "check:package": "node scripts/check-package.cjs",
    "dist:portable": "npm run build && electron-builder --win portable --publish never",
    "test:daily": "electron scripts/daily-e2e.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "dev.heao.pi-heao-gui",
    "productName": "Pi Heao GUI",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Q1y1ng",
        "repo": "pi-heao-gui"
      }
    ],
    "files": [
      "dist/**/*",
      "build/icon.png",
      "studio/pi-chat/dist/**/*",
      "studio/bridge/**/*",
      "!studio/bridge/pi-vscode-bridge.js",
      "!src/**/*",
      "!docs/**/*",
      "!**/*.map",
      "!**/tsconfig*.json",
      "!**/*.md",
      "studio/bridge/agents/**/*",
      "node_modules/node-pty/**",
      "LICENSE",
      "NOTICE.md"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Pi-Heao-GUI-${version}-Portable.exe"
    },
    "nsis": {
      "artifactName": "Pi-Heao-GUI-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pi Heao GUI",
      "uninstallDisplayName": "Pi Heao GUI ${version}",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "5.65.21",
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
